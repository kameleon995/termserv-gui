#!/bin/sh
# termserv-update: rebuild termserv's Python environment with current library
# releases (FastAPI, uvicorn, Jinja2, Textual, ...), test it, and switch to it.
# With --full, first update termserv itself. Also runs as: termservctl update
#
#   termserv-update            what the weekly timer runs: only releases at least
#                              TERMSERV_UPDATE_DELAY old (default 7 days)
#   termserv-update --now      urgent CVE fix: no delay (tests and rollback still apply)
#   termserv-update --full     also git pull the checkout install.sh ran from and,
#                              if it moved, re-run install.sh (combines with --now)
#   termserv-update --install  used by install.sh: always switch to the new build
#
# Layout: /opt/termserv/venv-<time> are complete environments, /opt/termserv/current
# points at the live one, /opt/termserv/dist holds the termserv wheel and
# /opt/termserv/tests the test suite. The previous environment is kept for rollback.
#
# Nothing is switched unless the new environment passes the test suite (run as an
# unprivileged user, so a test can never touch the real system) and, when the web
# UI is running, the web UI comes back up on it. Otherwise the old one stays live.
set -eu

BASE=${TERMSERV_BASE:-/opt/termserv}
DELAY=${TERMSERV_UPDATE_DELAY:-P7D}
WEB=termserv-web.service
SOURCE_FILE=${TERMSERV_SOURCE_FILE:-/etc/termserv/source}
mode=update
pull=no
for arg in "$@"; do
  case "$arg" in
    --now) DELAY="" ;;
    --full) pull=yes ;;
    --install) mode=install ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "usage: termserv-update [--now] [--full] | --install" >&2; exit 2 ;;
  esac
done
[ "$(id -u)" -eq 0 ] || { echo "termserv-update: run as root" >&2; exit 1; }

log() { echo "termserv-update: $*"; }
umask 022

# Progress, emerge style: ">>> (2 of 6) Installing ...". Under install.sh the
# steps are indented, as part of install.sh's own step.
web_active=no
if [ "$mode" = update ] && command -v systemctl >/dev/null && systemctl is-active -q "$WEB" 2>/dev/null; then
  web_active=yes
fi
total=5
[ "$mode" = update ] && [ "$pull" = yes ] && total=$((total + 1))
[ "$web_active" = yes ] && total=$((total + 1))
step_n=0
indent=""
[ "$mode" = install ] && indent="    "
started=$(date +%s)
step() { step_n=$((step_n + 1)); echo "$indent>>> ($step_n of $total) $*"; }
done_msg() {
  t=$(( $(date +%s) - started ))
  echo "$indent>>> $* ($((t / 60))m$((t % 60))s)"
}

# --full, termserv's own code: install.sh records the checkout it ran from in $SOURCE_FILE
# and the commit it installed in $BASE/.source-rev. Pull as the checkout's owner
# (fast-forward only, so local edits are never overwritten); if HEAD is now a
# commit that is not installed, hand over to install.sh, which rebuilds the wheel,
# tests it, and keeps the current version if anything fails.
if [ "$mode" = update ] && [ "$pull" = yes ]; then
  step "Pulling new termserv code"
fi
if [ "$mode" = update ] && [ "$pull" = yes ] && [ ! -f "$SOURCE_FILE" ]; then
  log "$SOURCE_FILE is missing; run install.sh once from the checkout. Updating the Python libraries only"
elif [ "$mode" = update ] && [ "$pull" = yes ]; then
  src=$(cat "$SOURCE_FILE")
  if [ -d "$src/.git" ] && command -v git >/dev/null; then
    owner=$(stat -c %U "$src")
    home=$(getent passwd "$owner" | cut -d: -f6)
    as_owner() { runuser -u "$owner" -- env HOME="$home" "$@"; }
    if as_owner git -C "$src" pull --ff-only -q; then
      rev=$(as_owner git -C "$src" rev-parse HEAD)
      if [ "$rev" != "$(cat "$BASE/.source-rev" 2>/dev/null || true)" ]; then
        log "new termserv code: $(as_owner git -C "$src" log -1 --format='%h %s'); continuing with install.sh"
        exec "$src/install.sh"
      fi
      log "termserv code is up to date ($(echo "$rev" | cut -c1-7))"
    else
      log "git pull in $src failed; updating the Python libraries only"
    fi
  else
    log "$src is not a git checkout; updating the Python libraries only"
  fi
fi

wheel=$(ls "$BASE"/dist/termserv-*.whl 2>/dev/null | sort -V | tail -n 1)
[ -n "$wheel" ] || { log "no termserv wheel in $BASE/dist; re-run install.sh"; exit 1; }

step "Creating a new Python environment"
new="$BASE/venv-$(date +%Y%m%d-%H%M%S)"
trap 'rm -rf "$new"' EXIT  # cancelled once the new environment is live
python3 -m venv "$new"
pip() { "$new/bin/python" -m pip --disable-pip-version-check --no-input -q "$@"; }

# pip learned --uploaded-prior-to in 26.0; the pip a fresh venv starts with may be older.
if ! pip install --help | grep -q -- --uploaded-prior-to; then
  pip install --upgrade "pip>=26.0"
fi
delay_arg=""
if [ -n "$DELAY" ]; then
  delay_arg="--uploaded-prior-to=$DELAY"
  pip install --upgrade "$delay_arg" pip
fi
step "Installing $(basename "$wheel") and its libraries${DELAY:+ (releases older than $DELAY)}"
# shellcheck disable=SC2086
pip install $delay_arg "$wheel[test]"
sha256sum "$wheel" | cut -d' ' -f1 >"$new/.termserv-wheel"
"$new/bin/python" -m pip freeze --all --exclude-editable >"$new/.termserv-freeze"

cur=""
[ -L "$BASE/current" ] && cur=$(readlink -f "$BASE/current")
if [ "$mode" = update ] && [ -n "$cur" ] &&
   cmp -s "$cur/.termserv-freeze" "$new/.termserv-freeze" &&
   cmp -s "$cur/.termserv-wheel" "$new/.termserv-wheel"; then
  done_msg "Already up to date; nothing changed"
  exit 0
fi
[ -n "$cur" ] && diff "$cur/.termserv-freeze" "$new/.termserv-freeze" | sed -n 's/^> /    new: /p' || true

step "Running the test suite in the new environment"
if [ -d "$BASE/tests" ]; then
  if ! (cd / && setpriv --reuid=nobody --regid=nogroup --clear-groups \
          env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/nonexistent TMPDIR=/tmp \
          "$new/bin/python" -m pytest -q -p no:cacheprovider "$BASE/tests"); then
    log "tests failed with the new libraries; keeping the current environment"
    exit 1
  fi
else
  "$new/bin/python" -c "import termserv.cli, termserv.tui, termserv.web.app"
fi

switch_to() {
  ln -sfn "$1" "$BASE/.current.new"
  mv -T "$BASE/.current.new" "$BASE/current"
}
web_ok() {
  i=0
  while [ $i -lt 15 ]; do
    systemctl is-active -q "$WEB" || return 1
    # still running after a few seconds = uvicorn is serving
    [ $i -ge 5 ] && return 0
    sleep 1; i=$((i + 1))
  done
  return 0
}

step "Switching to the new environment"
switch_to "$new"
trap - EXIT
log "now using $new"
if [ "$web_active" = yes ]; then
  step "Restarting the web UI"
  systemctl restart "$WEB" || true
  if ! web_ok; then
    if [ -n "$cur" ]; then
      log "web UI did not start on the new environment; rolling back to $cur"
      switch_to "$cur"
      systemctl restart "$WEB" || true
    fi
    rm -rf "$new"
    exit 1
  fi
  log "web UI restarted"
fi

step "Removing old environments"
# keep the live environment and the one before it
for d in "$BASE"/venv-*; do
  [ -d "$d" ] || continue
  [ "$d" = "$new" ] || [ "$d" = "$cur" ] || rm -rf "$d"
done
done_msg "Update finished"
