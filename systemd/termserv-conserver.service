[Unit]
Description=termserv: conserver serial console server (localhost only)
After=network.target systemd-udev-settle.service
ConditionPathExists=/etc/termserv/conserver.cf

[Service]
Type=exec
# -M 127.0.0.1  listen on localhost only; sshd is the only network front door
# -o            reopen a downed console when someone connects
# -O 1          retry downed consoles (e.g. unplugged USB adapters) every minute
# Rebuild conserver.cf so ports released with "termservctl release" come back
# after a reboot. "-": on a broken ports.yaml, keep the last good config.
ExecStartPre=-/usr/local/bin/termservctl regen-conserver
ExecStart=/usr/sbin/conserver -M 127.0.0.1 -C /etc/termserv/conserver.cf -P /etc/termserv/conserver.passwd -o -O 1
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
# Console logs hold everything typed on the ports (device passwords too): not world-readable.
UMask=0027
# Pid file /run/conserver/conserver.pid lets the distro's logrotate job tell this
# conserver to reopen its logs (SIGUSR2) after rotating them.
RuntimeDirectory=conserver
RestartSec=2

[Install]
WantedBy=multi-user.target
